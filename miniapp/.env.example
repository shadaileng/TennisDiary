# ============================================================
# 小程序前端环境配置模板
# 复制为 .env.development / .env.production 后按需修改（实际 .env 不提交）
# ============================================================

# 后台 API base URL
#  - 微信开发者工具 / H5 联调：http://127.0.0.1:8000
#  - 小程序真机预览：改为电脑局域网 IP，如 http://192.168.1.100:8000
#  - 生产环境：必须为已备案 HTTPS 域名
VITE_API_BASE_URL=http://127.0.0.1:8000

# 请求超时（毫秒），默认 10000
VITE_REQUEST_TIMEOUT=10000

# ------------------------------------------------------------
# 以下为构建期变量（非 VITE_ 前缀，不注入 import.meta.env，由
# vite.config.ts 在构建时读取并写入 dist/*/mp-weixin/project.config.json）
# ------------------------------------------------------------

# 微信小程序 AppID（登录 https://mp.weixin.qq.com 获取；部署小程序必填，
# 仅 H5 部署可留空）。支持在 .env.development / .env.production 中按环境覆盖。
TD_APPID=

# 域名白名单校验开关（对应 project.config.json 的 setting.urlCheck）：
#  - false：开发阶段「不校验合法域名」（允许 http / localhost）
#  - true ：生产环境校验合法域名（request 域名需在微信后台配置并备案）
TD_URL_CHECK=false
