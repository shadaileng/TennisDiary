# ============================================================
# Tennis Diary Server - Oracle Cloud Always Free 部署配置模板
# 复制为 .env.oci 后填入实际值（.env.oci 已加入 .gitignore）
# ============================================================

# OCI VM SSH 连接
OCI_VM_USER=ubuntu
OCI_VM_HOST=your-oracle-public-ip
OCI_SSH_PORT=22

# SSH 私钥路径（本机，默认指向 ~/.ssh/id_ed25519）
# 在 OCI 控制台创建实例时上传的公钥对应的私钥
OCI_SSH_KEY=~/.ssh/id_ed25519

# 远端应用目录（默认 /opt/tennis-diary）
OCI_APP_DIR=/opt/tennis-diary

# ------------------------------------------------------------------
# 以下配置会写入服务器 /opt/tennis-diary/.env（无需手工上传）
# ------------------------------------------------------------------

# JWT 签名密钥（强随机 64 位十六进制字符串，256 位熵）
# 生成命令（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# 微信小程序配置
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret-here

# 管理员初始密码
ADMIN_DEFAULT_PASSWORD=changeme

# 管理员重置密钥（用于重置密码，可为空）
ADMIN_RESET_KEY=