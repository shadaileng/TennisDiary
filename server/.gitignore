# 环境变量（模板 .env.example 纳入版本管理）
.env

# 运行时数据（全部在 data/ 下）
data/

# 虚拟环境
venv/
.venv/

# uv（uv.lock 纳入版本管理，保证本地/CI/魔搭三方依赖一致）
.python-version

# 测试
.pytest_cache/
htmlcov/
.coverage
.testmondata

# MediaPipe 姿态模型（约 5.7MB 二进制，不纳入仓库；用 scripts/download-pose-model.sh 下载）
# 注意：必须锚定到 server 根目录，否则会连带忽略 app/models/ 下的 ORM 模型源文件
/models/
!models/.gitkeep

# IDE
.idea/
.vscode/
