# ============================================================
# Tennis Diary Server - HF Space 部署配置模板
# 复制为 .env.hf 后填入实际值（.env.hf 已加入 .gitignore）
#
# 注意：HF Space Docker Runner 不会自动读取 .env.hf 文件
# 部署脚本会读取此文件中的 HF_TOKEN/HF_USERNAME/HF_SPACE_NAME
# 并生成正确的 .env 文件推送到 HF Space
# ============================================================

# Hugging Face 账号信息
HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
HF_USERNAME=your-hf-username
HF_SPACE_NAME=tennis-diary-server

# JWT 签名密钥（强随机 64 位十六进制字符串，256 位熵）
# 生成命令（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# 微信小程序配置
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret-here

# 管理员初始密码
ADMIN_DEFAULT_PASSWORD=changeme

# 管理员重置密钥（用于重置密码，可为空）
ADMIN_RESET_KEY=
