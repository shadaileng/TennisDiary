# ===================================
# Tennis Diary Server - HF Space 部署配置模板
# 使用方法：
#   1. cp .env.hf.example .env.hf
#   2. 编辑 .env.hf 填入实际值
# ===================================

# ---------- 部署凭据 ----------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
HF_USERNAME=your-hf-username
HF_SPACE_NAME=tennis-diary-server

# ---------- 必配项 (P0) ----------

# 数据库配置 (PostgreSQL 连接串)
# 来源：Supabase Dashboard → Connection String → Driver: PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.xxx.supabase.co:5432/tennis_diary

# 基础认证
JWT_SECRET=your-32-char-random-jwt-secret-key-here
WX_APPID=wx1234567890abcdef
WX_SECRET=your-wechat-secret-key-here
ADMIN_DEFAULT_PASSWORD=Admin@2024!Secure
ADMIN_RESET_KEY=your-32-char-random-reset-token-here

# ---------- 可选配置 ----------

# 对象存储 (七牛 KODO) - 启用需设置所有必填项
STORAGE_BACKEND=local
# STORAGE_BACKEND=kodo
STORAGE_ENDPOINT=https://s3.z2.qiniucs.com
STORAGE_REGION=z2
STORAGE_BUCKET=tennis-diary
STORAGE_ACCESS_KEY=AK_your_kodo_access_key
STORAGE_SECRET_KEY=<your-kodo-secret-key>
STORAGE_PUBLIC_BASE_URL=https://cdn.tennisdiary.com

# AI 配置 (阿里云百炼)
AI_API_KEY=<your-aliyun-api-key>
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-max
AI_PROVIDER=aliyun

# 数据库连接池 (仅 PostgreSQL 生效，已有默认值)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# 日志配置
LOG_LEVEL=INFO
LOG_JSON_ENABLED=false
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# 调试配置
DEBUG=false
DATA_DIR=/data
JWT_EXPIRATION_HOURS=720
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100
LOG_DIR=/data/logs
ADMIN_DEFAULT_USERNAME=admin
