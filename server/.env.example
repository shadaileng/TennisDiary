# ============================================================
# 后台 FastAPI 环境配置模板
# 复制为 .env 后按需修改（.env 不提交，已被 .gitignore 忽略）
# ============================================================

# 应用
DEBUG=true

# 数据目录（数据库 + 上传文件）
DATA_DIR=./data

# 数据库（默认使用 DATA_DIR 下的 SQLite，可替换为 PostgreSQL 等）
DATABASE_URL=sqlite:///./data/tennis_diary.db

# JWT（生产环境务必改成强随机值）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRATION_HOURS=720

# 微信小程序（登录 code2Session 必需）
WX_APPID=
WX_SECRET=

# AI（阿里云百炼 / OpenAI 兼容，预留）
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-max

# 文件上传
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100

# 日志
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_FILE=app.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_JSON_ENABLED=false

# 管理员（首次启动自动创建默认管理员）
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme
ADMIN_RESET_KEY=

# 日志分离（按角色输出到不同文件）
LOG_ADMIN_FILE=admin.log
LOG_USER_FILE=user.log

# ============================================================
# 对象存储（147 阶段一 KODO 对象存储，按需启用）
# 默认 backend=local（纯本地文件），切 kodo 需填下方凭据
# 查看配置页「系统 → 配置 → 对象存储」可在线修改
# ============================================================

# 存储后端：local(本地受管目录) / kodo(七牛 S3 兼容)
STORAGE_BACKEND=local

# 七牛 S3 兼容接口凭据（backend=kodo 时必填）
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Bucket 与 Region（region 决定 endpoint 与存储类型）
STORAGE_BUCKET=
STORAGE_REGION=z0
# endpoint 可显式覆盖（留空则按 region 内建推导）
STORAGE_ENDPOINT=

# 外链域名（已备案；留空时响应层回落 presigned GET，默认 2h 过期）
# 小程序 <image>/<video> 走外链需要该域名配进 downloadFile 合法域名白名单
# 注：配置页校验要求以 http(s):// 开头，空串会返回 400；想清空填一个占位符即可
STORAGE_PUBLIC_BASE_URL=http://localhost:8000
