# ============================================================
# 后台 FastAPI 环境配置模板
# 复制为 .env 后按需修改（.env 不提交，已被 .gitignore 忽略）
# ============================================================

# 应用
DEBUG=true

# 数据目录（数据库 + 上传文件）
DATA_DIR=./data

# JWT（生产环境务必改成强随机值）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRATION_HOURS=720

# 微信小程序（登录 code2session 必需）
WX_APPID=
WX_SECRET=

# AI（预留，当前未启用）
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-max

# 文件上传
MAX_UPLOAD_SIZE_MB=100
