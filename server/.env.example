# ==================== 应用配置 ====================
# 调试模式（生产环境请设为 false）
DEBUG=false

# ==================== 数据库 ====================
# SQLite 数据库文件路径（相对于 server/ 目录）
DATABASE_URL=sqlite:///./data/tennis_diary.db

# ==================== JWT ====================
# JWT 签名密钥（生产环境务必更换为随机字符串）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production-please
# Token 有效期（小时），默认 720 = 30 天
JWT_EXPIRATION_HOURS=720

# ==================== 微信小程序 ====================
# 微信小程序 AppID（必填）
WX_APPID=
# 微信小程序 AppSecret（必填，勿泄露）
WX_SECRET=

# ==================== AI 配置 ====================
# AI API Key（阿里云百炼 / OpenAI 兼容）
AI_API_KEY=
# AI 接口地址
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI 模型名称
AI_MODEL=qwen-vl-max

# ==================== 文件存储 ====================
# 上传文件存储目录
UPLOAD_DIR=./data/uploads
# 单文件最大上传大小（MB）
MAX_UPLOAD_SIZE_MB=100

# ==================== 日志 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（默认继承 DATA_DIR）
LOG_DIR=./data/logs
# 日志文件名
LOG_FILE=app.log
# 文件滚动切割（按大小，如 10 MB / 500 KB）
LOG_ROTATION=10 MB
# 日志保留时长（如 7 days / 30 days）
LOG_RETENTION=7 days
