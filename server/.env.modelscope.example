# ============================================================
# Tennis Diary Server - 魔搭创空间(ModelScope Studio) 部署配置模板
# 复制为 .env.modelscope 后填入实际值（.env.modelscope 已加入 .gitignore）
# ============================================================

# 魔搭 Access Token（个人中心 → 访问令牌）
MODEL_SCOPE_TOKEN=<your-modelscope-token>
# 魔搭用户名
MODEL_SCOPE_USERNAME=<your-modelscope-username>
# 魔搭创建的小程序后端创空间名称
MODEL_SCOPE_STUDIO_NAME=tennis-diary-server

# 创空间可见性：true=私密 / false=公开体验
# 默认 false（公开），避免 .ms.show 公网访问被网关拦截返回 10011402001
MODEL_SCOPE_VISIBILITY=false

# 魔搭 API 地址（默认 https://modelscope.cn/openapi/v1）
# MS_API_BASE=https://modelscope.cn/openapi/v1

# 推送到魔搭的 Git 主机（默认 www.modelscope.cn）
# MS_HOST=www.modelscope.cn

#
# 必配项 (P0) - 数据库必须配置，其他认证项必需
#

# 数据库配置 (PostgreSQL 连接串)
# 来源：Supabase Dashboard → Connection String → Driver: PostgreSQL
# 必须使用格式：postgresql+psycopg://postgres:your_password@db.xxx.supabase.co:5432/tennis_diary
DATABASE_URL=<your-postgresql-connection-string>

# JWT 签名密钥（强随机 64 位十六进制字符串，256 位熵）
# 生成命令（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
JWT_SECRET=<your-jwt-secret-here>

# 微信小程序配置
WX_APPID=<your-wechat-appid>
WX_SECRET=<your-wechat-secret-here>

# 管理员初始密码
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# 管理员重置密钥（用于重置密码，可为空）
ADMIN_RESET_KEY=<your-random-reset-token-here>

#
# 可选配置 - 对象存储 (七牛 KODO)
# 启用需设置所有必填项，否则使用 local 存储
#

# 存储后端类型: local 或 kodo
STORAGE_BACKEND=local
# STORAGE_BACKEND=kodo
# 需要 KODO 配置时，以下所有字段必须设置
# STORAGE_ENDPOINT=https://s3.z2.qiniucs.com
# STORAGE_REGION=z2
# STORAGE_BUCKET=tennis-diary
# STORAGE_ACCESS_KEY=<your-kodo-access-key>
# STORAGE_SECRET_KEY=<your-kodo-secret-key>
# STORAGE_PUBLIC_BASE_URL=https://tennis-diary.qiniudns.com

#
# 可选配置 - AI 服务商
# 未配置时服务降级到本地默认 AI 参数
#

AI_API_KEY=<your-aliyun-api-key>
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-max
AI_PROVIDER=

#
# 可选配置 - 数据库连接池
# 已有合理默认值，无需配置即可运行
#

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
