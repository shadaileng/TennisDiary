# ============================================================
# Tennis Diary Server - 魔搭创空间(ModelScope Studio) 部署配置模板
# 复制为 .env.modelscope 后填入实际值（.env.modelscope 已加入 .gitignore）
# ============================================================

# 魔搭 Access Token（个人中心 → 访问令牌）
MODEL_SCOPE_TOKEN=modelscope_xxxxxxxxxxxxxxxxx
# 魔搭用户名
MODEL_SCOPE_USERNAME=your-modelscope-username
# 魔搭创建的小程序后端创空间名称
MODEL_SCOPE_STUDIO_NAME=tennis-diary-server

# 创空间可见性：true=私密 / false=公开体验
# 默认 false（公开），避免 .ms.show 公网访问被网关拦截返回 10011402001
MODEL_SCOPE_VISIBILITY=false

# 魔搭 API 地址（默认 https://modelscope.cn/openapi/v1）
# MS_API_BASE=https://modelscope.cn/openapi/v1

# 推送到魔搭的 Git 主机（默认 www.modelscope.cn）
# MS_HOST=www.modelscope.cn

# JWT 签名密钥（强随机 64 位十六进制字符串，256 位熵）
# 生成命令（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# 微信小程序配置
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret-here

# 管理员初始密码
ADMIN_DEFAULT_PASSWORD=changeme

# 管理员重置密钥（用于重置密码，可为空）
ADMIN_RESET_KEY=